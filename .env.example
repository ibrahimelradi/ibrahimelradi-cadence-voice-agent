# ─────────────────────────────────────────────────────────────────────────────
# Cadence voice agent — server environment
# Copy to .env.local and fill in at least one setup:
#
#   Free mode (no cost):                          GEMINI_API_KEY (free at aistudio.google.com)
#                                                 or GROQ_API_KEY (free at console.groq.com)
#   Realtime mode (best quality, lowest latency): OPENAI_API_KEY
#   Modular mode with Claude:                     ANTHROPIC_API_KEY + OPENAI_API_KEY
#                                                 (or ANTHROPIC_API_KEY + ELEVENLABS_API_KEY)
#
# These keys are read only on the server and are never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Provider keys ------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- OpenAI Realtime (speech-to-speech over WebRTC) ---------------------------
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Free mode: reasoning (free-tier models; limits set by each provider) -------
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or unavailable:
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# GEMINI_REASONING_EFFORT=low        # "none" to omit; lower = faster spoken replies
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# --- Modular pipeline: reasoning ------------------------------------------------
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort trades depth for speed. "low" keeps spoken replies snappy.
# ANTHROPIC_EFFORT=low
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low        # only for reasoning models that accept it

# --- Modular pipeline: speech ---------------------------------------------------
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Networking / security ----------------------------------------------------
# Point at a proxy or compatible gateway if needed.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Extra origins allowed to call the API routes (comma-separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://voice.example.com
# Set to 1 to disable the built-in per-IP rate limiter (e.g. behind your own gateway).
# DISABLE_RATE_LIMIT=0
